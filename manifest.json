{
  "manifest_version": 3,
  "name": "MSK",
  "version": "1.5.0",
  "description": "Custom photo/video backgrounds, candle colors and animations for TradingView charts.",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MSK",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_page": "studio/index.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.tradingview.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.tradingview.com/chart*"
      ],
      "js": [
        "studio/fx.js",
        "engine.js",
        "bridge-main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.tradingview.com/chart*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "layer.html",
        "layer.js",
        "common.js",
        "studio/fx.js"
      ],
      "matches": [
        "https://*.tradingview.com/*"
      ]
    }
  ],
  "commands": {
    "toggle-bg": {
      "suggested_key": {
        "default": "Alt+Shift+M"
      },
      "description": "Turn background on/off"
    },
    "next-config": {
      "suggested_key": {
        "default": "Alt+Shift+Period"
      },
      "description": "Next config"
    },
    "toggle-fx": {
      "suggested_key": {
        "default": "Alt+Shift+Comma"
      },
      "description": "Pause/resume animations"
    },
    "toggle-checklist": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Show/hide the trading checklist"
    }
  }
}